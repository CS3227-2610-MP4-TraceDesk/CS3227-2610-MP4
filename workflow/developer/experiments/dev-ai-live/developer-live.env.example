# Developer live AI evaluation settings (template - contains no secrets).
#
# 1. Copy this file to the repository root as `.env.developer-live`
#    (that name is gitignored by `.env.*`; never commit the filled copy).
# 2. Fill in every value. Lines starting with # are ignored.
# 3. Run `run-live.ps1 -Fingerprint` to get the key fingerprint for the approval file,
#    fill in runs/developer-live-approval.json (see README.md), then `run-live.ps1`.

# --- AI provider (backend only) ---
SOCLAAS_API_KEY=
SOCLAAS_MODEL=

# --- Enablement: you confirm the sponsored access is approved and when it expires ---
AI_ENABLED=true
AI_SPONSORED_ACCESS_ACKNOWLEDGED=true
# Short label for your approval, e.g. course sponsorship reference (no secrets)
AI_SPONSORED_APPROVAL_REFERENCE=
# UTC, e.g. 2026-11-20T00:00:00Z
AI_SPONSORED_APPROVAL_EXPIRES_AT=
# Must both equal 276000 for the default 3 repetitions (30 calls x 9200 units)
AI_ACTOR_DAILY_UNITS=276000
AI_GLOBAL_DAILY_UNITS=276000

# --- Live run labels: must match the approval file exactly ---
# e.g. soclaas-course-account
TRACEDESK_DEVELOPER_LIVE_ACCOUNT_ENVIRONMENT=
# e.g. local-env-file
TRACEDESK_DEVELOPER_LIVE_CREDENTIAL_SOURCE=
TRACEDESK_DEVELOPER_LIVE_CONFIRM=developer-synthetic-only-30
TRACEDESK_DEVELOPER_LIVE_REPETITIONS=3

# --- Isolated TEST database (never your real app database) ---
TRACEDESK_TEST_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/tracedesk_test
TRACEDESK_TEST_DATABASE_USER=
TRACEDESK_TEST_DATABASE_PASSWORD=
TRACEDESK_TEST_DATABASE_CONFIRM_ISOLATED=true
